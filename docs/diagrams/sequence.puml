@startuml sequence
skinparam backgroundColor #FAFAFA

title Sequence Diagram — Webster\nRegister → Edit → Autosave → Share

actor User
actor Guest
participant "React Frontend" as FE
participant "NestJS Backend" as BE
participant "MongoDB" as DB
participant "Brevo SMTP" as Mail

== Register & Verify ==

User -> FE : Submit registration form
FE -> BE : mutation register
BE -> DB : Create user (isEmailVerified: false)
BE -> Mail : Send verification email
Mail --> User : Email with link
User -> FE : Open /verify-email?token=...
FE -> BE : mutation verifyEmail
BE -> DB : Set isEmailVerified = true
BE --> FE : OK

== Login ==

User -> FE : Enter credentials
FE -> BE : mutation login
BE -> DB : Validate user & password
BE --> FE : Set HttpOnly cookies\n(access + refresh tokens)
FE --> User : Redirect to /projects

== Edit & Autosave ==

User -> FE : Open editor (?projectId)
FE -> BE : query project(id)
BE -> DB : Find project
DB --> BE : Project + content (JSON)
BE --> FE : Project data
FE -> FE : Load canvas scene

User -> FE : Edit canvas
FE -> FE : Debounce 1.2s
FE -> BE : mutation autosaveProject(id, content)
BE -> DB : Update project.content
BE --> FE : { id, updatedAt }
FE --> User : Show "Saved"

== Image Upload ==

User -> FE : Drop image on canvas
FE -> FE : Show blob preview
FE -> BE : POST /upload
BE -> DB : Save upload metadata
BE --> FE : { url: /uploads/... }
FE -> FE : Replace preview with server URL

== Sharing ==

User -> FE : Share → choose role\n(View only / Can edit)
FE -> BE : mutation createShareLink\n(projectId, role)
BE -> DB : Create share link (token, role)
BE --> FE : { url, token, role }
FE --> User : Copy link

note over FE, BE
  Owner can also change role
  or revoke via updateShareLinkRole / revokeShareLink
end note

Guest -> FE : Open /share/:token
FE -> BE : query resolveShareLink(token)
BE -> DB : Validate token, load project
BE --> FE : { project, role, canEdit }

alt role = VIEWER
  FE --> Guest : Read-only canvas\n(pan / zoom only)
else role = EDITOR
  FE -> FE : Redirect /editor/share/:token
  Guest -> FE : Edit canvas
  FE -> BE : mutation autosaveSharedProject\n(token, content)
  BE -> DB : Update project.content
  BE --> FE : { updatedAt }
  FE --> Guest : Show "Saved"
end

@enduml
