@startuml activity
skinparam backgroundColor #FAFAFA
skinparam activity {
  BackgroundColor LightBlue
  BorderColor DarkSlateGray
  ArrowColor DarkSlateGray
}

title Activity Diagram — Webster\n(Register → Edit → Share)

start

:Open Webster;

if (Authenticated?) then (no)
  if (Has account?) then (yes — login)
    :Login (email + password);
    if (Email verified?) then (no)
      :Verify email via link;
    endif
    :Receive session cookies;
  else (no — register)
    :Register;
    :Verify email;
    :Login;
  endif
endif

if (Opened share link?) then (yes)
  :resolveShareLink(token);
  if (Link role?) then (VIEWER)
    :View canvas (read-only)\n/share/:token;
    stop
  else (EDITOR)
    :Open collaborative editor\n/editor/share/:token;
    repeat
      :Edit canvas;
      :Autosave via token\n(autosaveSharedProject);
    repeat while (Continue?) is (yes)
    stop
  endif
endif

:Open projects list;

if (Optional: Profile) then (yes)
  :Set avatar\n(preset or upload);
endif

if (New or existing project?) then (new)
  :Create project\n(from template or blank);
else (existing)
  :Open editor;
endif

:Load project content;

repeat
  :Edit canvas\n(shapes, text, images, layers, groups);

  if (Added image?) then (yes)
    :Show instant preview;
    :Upload to server;
  endif

  :Autosave to database;

repeat while (Continue editing?) is (yes)

if (Next action?) then (Export)
  :Export (PNG / JPG / PDF / WEBP);
elseif (Share)
  :Open Share dialog;
  :Choose role:\nView only or Can edit;
  :Create link & copy;
  if (Manage existing links?) then (yes)
    :Change role or revoke;
  endif
elseif (Version history)
  :Save or restore version;
else (Done)
  :Return to projects;
endif

stop

@enduml
