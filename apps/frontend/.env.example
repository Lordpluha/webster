# Local dev (Vite :5173 → API :4000). On server behind nginx use /graphql instead.
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_APP_NAME=Webster
VITE_APP_ENV=development

# OAuth (optional). If set, login page buttons will redirect to providers.
# Must match OAuth app settings' "Authorized redirect URI":
# http://localhost:5173/oauth/callback (dev) or https://<your-domain>/oauth/callback (prod)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_FACEBOOK_CLIENT_ID=
