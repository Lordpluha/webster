NODE_ENV=development
PORT=4000

# MongoDB
# Docker Compose (backend container → mongo service):
# MONGODB_URI=mongodb://webster:webster@mongo:27017/webster?authSource=admin
# Local backend + mongo published on host:
MONGODB_URI=mongodb://webster:webster@127.0.0.1:27017/webster?authSource=admin

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_DAYS=7

# SMTP (optional — if SMTP_HOST unset, verification links are logged only)
# Production: Brevo — https://app.brevo.com/settings/keys/smtp
#   SMTP_USER = login from that page (often your Brevo account email)
#   SMTP_PASS = SMTP key (xsmtpsib-...), NOT API key or account password
#   SMTP_FROM must match a verified sender in Brevo → Senders (not .local)
SMTP_HOST=smtp-relay.brevo.com
# Use 2525 on DigitalOcean (blocks 25/465/587). Brevo also supports 587 locally.
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Webster <you@example.com>

# App
FRONTEND_URL=http://localhost:5173
GRAPHQL_PLAYGROUND=false
APP_NAME=Webster

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
